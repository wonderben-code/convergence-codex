import PatiSalamTwoStageStabiliser
import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.Analysis.Matrix.Spectrum
import Mathlib.LinearAlgebra.UnitaryGroup

open Matrix Complex NormedSpace TracelessSkewDimension
open scoped Matrix.Norms.Operator

namespace SkewAdjointExponential

variable {n : ℕ}

/-- **The exponential of a skew-adjoint matrix is unitary.** -/
theorem exp_mem_unitaryGroup (X : Matrix (Fin n) (Fin n) ℂ)
    (hX : X ∈ skewAdjoint (Matrix (Fin n) (Fin n) ℂ)) :
    exp X ∈ Matrix.unitaryGroup (Fin n) ℂ := by
  rw [Matrix.mem_unitaryGroup_iff]
  have hs : star X = -X := skewAdjoint.mem_iff.mp hX
  rw [Matrix.star_eq_conjTranspose, ← Matrix.exp_conjTranspose, ← Matrix.star_eq_conjTranspose, hs,
    ← Matrix.exp_add_of_commute X (-X) (Commute.neg_right (Commute.refl X)), add_neg_cancel,
    NormedSpace.exp_zero]

/-- **`det (exp (c • H)) = exp (c · tr H)` for Hermitian `H`**: diagonalise by the spectral theorem,
exponentiate the diagonal, multiply the eigenvalue exponentials. -/
theorem det_exp_smul_of_isHermitian (H : Matrix (Fin n) (Fin n) ℂ) (hH : H.IsHermitian) (c : ℂ) :
    det (exp (c • H)) = Complex.exp (c * trace H) := by
  set U : Matrix (Fin n) (Fin n) ℂ := (hH.eigenvectorUnitary : Matrix (Fin n) (Fin n) ℂ) with hUdef
  have hU : star U * U = 1 := Unitary.coe_star_mul_self hH.eigenvectorUnitary
  have hU' : U * star U = 1 := Unitary.coe_mul_star_self hH.eigenvectorUnitary
  have hspec : H = U * diagonal (fun i => (hH.eigenvalues i : ℂ)) * star U := by
    have h := hH.spectral_theorem
    simpa [Unitary.conjStarAlgAut_apply, Function.comp_def] using h
  have hUunit : IsUnit U := ⟨⟨U, star U, hU', hU⟩, rfl⟩
  have hinv : U⁻¹ = star U := Matrix.inv_eq_left_inv hU
  have hcH : c • H = U * diagonal (fun i => c * (hH.eigenvalues i : ℂ)) * U⁻¹ := by
    conv_lhs => rw [hspec]
    rw [hinv, ← Matrix.smul_mul, ← Matrix.mul_smul, ← Matrix.diagonal_smul]
    rfl
  rw [hcH, Matrix.exp_conj _ _ hUunit, Matrix.det_conj hUunit, Matrix.exp_diagonal, det_diagonal,
    hH.trace_eq_sum_eigenvalues, Finset.mul_sum, Complex.exp_sum]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [Pi.coe_exp, ← Complex.exp_eq_exp_ℂ]
  rfl

/-- A skew-adjoint matrix is `i` times a Hermitian one: `(-i) • X` is Hermitian. -/
theorem isHermitian_neg_I_smul (X : Matrix (Fin n) (Fin n) ℂ)
    (hX : X ∈ skewAdjoint (Matrix (Fin n) (Fin n) ℂ)) : ((-I) • X).IsHermitian := by
  have hs : Xᴴ = -X := by
    rw [← Matrix.star_eq_conjTranspose]; exact skewAdjoint.mem_iff.mp hX
  rw [Matrix.IsHermitian, Matrix.conjTranspose_smul, hs]
  simp [smul_neg, neg_smul]

/-- **`det (exp X) = exp (tr X)` for skew-adjoint `X`.** -/
theorem det_exp_of_skewAdjoint (X : Matrix (Fin n) (Fin n) ℂ)
    (hX : X ∈ skewAdjoint (Matrix (Fin n) (Fin n) ℂ)) :
    det (exp X) = Complex.exp (trace X) := by
  have hH := isHermitian_neg_I_smul X hX
  have hX' : I • ((-I) • X) = X := by rw [smul_smul]; simp
  calc det (exp X) = det (exp (I • ((-I) • X))) := by rw [hX']
    _ = Complex.exp (I * trace ((-I) • X)) := det_exp_smul_of_isHermitian _ hH I
    _ = Complex.exp (trace X) := by rw [trace_smul, smul_eq_mul, ← mul_assoc]; simp

/-- **Traceless skew-adjoint exponentiates into `SU(n)`** — Mathlib's `specialUnitaryGroup`. -/
theorem exp_mem_specialUnitaryGroup (X : Matrix (Fin n) (Fin n) ℂ)
    (hX : X ∈ skewAdjoint (Matrix (Fin n) (Fin n) ℂ)) (htr : trace X = 0) :
    exp X ∈ Matrix.specialUnitaryGroup (Fin n) ℂ :=
  Matrix.mem_specialUnitaryGroup_iff.mpr
    ⟨exp_mem_unitaryGroup X hX, by rw [det_exp_of_skewAdjoint X hX, htr, Complex.exp_zero]⟩

/-- The exponential of an element of this estate's `traceless n` (`su(n)` as a subspace), as an
element of `SU(n)`. -/
noncomputable def expSU (A : traceless n) : Matrix.specialUnitaryGroup (Fin n) ℂ :=
  ⟨exp ((A : skewAdjoint (Matrix (Fin n) (Fin n) ℂ)) : Matrix (Fin n) (Fin n) ℂ),
    exp_mem_specialUnitaryGroup _ (A : skewAdjoint (Matrix (Fin n) (Fin n) ℂ)).2
      (trace_eq_zero_of_mem_traceless A.2)⟩

theorem expSU_val (A : traceless n) :
    (expSU A : Matrix (Fin n) (Fin n) ℂ)
      = exp ((A : skewAdjoint (Matrix (Fin n) (Fin n) ℂ)) : Matrix (Fin n) (Fin n) ℂ) := rfl

/-- The one-parameter subgroup `t ↦ exp (t • A)` of `SU(n)` generated by `A ∈ su(n)`. -/
noncomputable def oneParam (A : traceless n) (t : ℝ) : Matrix.specialUnitaryGroup (Fin n) ℂ :=
  expSU (t • A)

theorem coe_smul_traceless (A : traceless n) (t : ℝ) :
    (((t • A : traceless n) : skewAdjoint (Matrix (Fin n) (Fin n) ℂ)) : Matrix (Fin n) (Fin n) ℂ)
      = t • ((A : skewAdjoint (Matrix (Fin n) (Fin n) ℂ)) : Matrix (Fin n) (Fin n) ℂ) := by
  rw [Submodule.coe_smul, skewAdjoint.val_smul]
  rfl

theorem oneParam_zero (A : traceless n) : oneParam A 0 = 1 := by
  apply Subtype.ext
  simp [oneParam, expSU_val]

theorem oneParam_add (A : traceless n) (s t : ℝ) :
    oneParam A (s + t) = oneParam A s * oneParam A t := by
  apply Subtype.ext
  simp only [Submonoid.coe_mul, oneParam, expSU_val, coe_smul_traceless, add_smul]
  exact Matrix.exp_add_of_commute _ _ (((Commute.refl _).smul_left s).smul_right t)

/-- **The gauge group `SU(4) × SU(2)_L × SU(2)_R`, reached from the estate's own Lie algebra**: the
exponential of an element of unit 183's `Full = su(4) ⊕ su(2) ⊕ su(2)`, factor by factor. -/
noncomputable def expFull (p : PatiSalamTwoStageStabiliser.Full) :
    Matrix.specialUnitaryGroup (Fin 4) ℂ × Matrix.specialUnitaryGroup (Fin 2) ℂ
      × Matrix.specialUnitaryGroup (Fin 2) ℂ :=
  (expSU p.1, expSU p.2.1, expSU p.2.2)

end SkewAdjointExponential
